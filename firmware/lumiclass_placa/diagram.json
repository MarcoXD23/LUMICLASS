    [ "pir2:OUT", "esp:26", "green", [] ],
    [ "pir2:VCC", "esp:5V", "red", [] ],
    [ "pir2:GND", "esp:GND.1", "black", [] ],
    [ "led_estado:A", "r1:1", "blue", [] ],
    [ "r1:2", "esp:2", "blue", [] ],
