# Copia este archivo como .env y ajusta los valores.
# Puerto HTTP de la API.
PUERTO=3000
# Interfaz de red. Usa 0.0.0.0 para abrir la app desde un celular en la misma red.
HOST=127.0.0.1
# Hardware: "simulado" (por defecto) o "real" (Fase 8).
DRIVER=simulado
# Base de datos SQLite (ruta relativa a apps/backend).
DATABASE_URL=file:./prisma/dev.db
# Tiempo máximo (ms) que se espera la confirmación de un servo antes de marcar error.
TIEMPO_MAX_ACTUADOR_MS=3000
# Cada cuánto (ms) se revisan las reglas aunque no cambie la presencia.
INTERVALO_REGLAS_MS=60000
# Demora (ms) del servo simulado en modo "lento" (debe ser menor que TIEMPO_MAX_ACTUADOR_MS).
SIM_DEMORA_LENTO_MS=2000
# Máximo de pantallas conectadas en tiempo real a la vez.
MAX_CONEXIONES_SSE=50
# Cada cuánto (ms) se envía un latido por la conexión de tiempo real.
LATIDO_SSE_MS=15000
# ── Autenticación ──
# Duración de la sesión (horas).
DURACION_SESION_HORAS=8
# true solo si la app se sirve por HTTPS.
COOKIE_SEGURA=false
# Correos: por ahora solo "simulado" (consola + bandeja /correos).
CORREO_MODO=simulado
# Dirección de la app para los enlaces de los correos.
URL_APP=http://localhost:5173
# Primer administrador (se crea al iniciar si no existe ninguno).
ADMIN_CORREO=admin@lumiclass.local
ADMIN_NOMBRE=Administrador
# ¡Cámbiala! Si la quitas, se genera una al azar y se muestra una vez en la consola.
ADMIN_CONTRASENA=CambiaEsta2026
